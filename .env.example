# Copy this file to .env.local and fill in the values after each "=".
# .env.local is ignored by Git. Never commit it and never paste these values into chat.
# Restart `npm run dev` after a change.

# Supabase project URL, e.g. https://abcd.supabase.co
# Supabase dashboard: Project Settings -> API Keys (or Data API). Dev project for now.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe for the browser; RLS protects the data.
# Supabase dashboard: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY. Bypasses row-level security.
# Never add a NEXT_PUBLIC_ prefix to this name. Supabase dashboard: Project Settings -> API Keys.
SUPABASE_SECRET_KEY=

# Database connection string for automated access-rule tests (Prompt 03). DEV DATABASE ONLY.
# Laptop only: never add this to Vercel. Supabase dashboard: Connect -> Session pooler,
# with your database password in place of [YOUR-PASSWORD].
SUPABASE_DB_URL=

# Preview role for local development only, until Google sign-in arrives in Prompt 03.
# One of: learner, champion, manager, trainer, admin
# Production builds ignore this and always show a learner.
DEV_PREVIEW_ROLE=learner
