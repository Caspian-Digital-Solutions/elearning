# Copy this file to .env.local and fill in the values after each "=".
# .env.local is ignored by Git. Never commit it and never paste these values into chat.
# Restart `npm run dev` after a change.

# Supabase project URL, e.g. https://abcd.supabase.co
# Supabase dashboard: Project Settings -> API Keys (or Data API). Dev project for now.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe for the browser; RLS protects the data.
# Supabase dashboard: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY. Bypasses row-level security.
# Never add a NEXT_PUBLIC_ prefix to this name. Supabase dashboard: Project Settings -> API Keys.
SUPABASE_SECRET_KEY=

# Database connection string for `npm run test:rls` (automated access-rule tests). DEV DATABASE ONLY.
# Laptop only: never add this to Vercel. Supabase dashboard: Connect -> Session pooler,
# with your database password in place of [YOUR-PASSWORD].
SUPABASE_DB_URL=

# Dev Supabase project ref (subdomain before .supabase.co). Required for npm run demo:seed and demo:clear.
DEV_PROJECT_REF=

# Production project (laptop scripts only — never add prod secret or DB URL to Vercel until cut-over).
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_URL=
SUPABASE_PROD_SECRET_KEY=
SUPABASE_PROD_DB_URL=

# deployment environment: development | preview | production
# Production refuses sample/demo content and test-account sign-in. Vercel Production should set production.
APP_ENV=

# Optional. Lets an ADMIN preview another role's menus on this laptop (`npm run dev` only).
# One of: learner, champion, manager, trainer, admin. Leave blank to see your real role.
# Ignored for anyone who is not an admin, and ignored in every deployed build.
DEV_PREVIEW_ROLE=
